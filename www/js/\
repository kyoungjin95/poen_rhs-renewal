async function getDataUrl(camera_img, no) {
	// Create canvas
	const canvas = document.createElement('canvas');
	const ctx = canvas.getContext('2d');

	// Draw the image
	//ctx.scale(0.5, 0.5);
	ctx.drawImage(camera_img, 0, 0, 200, 200);

	var base64 = canvas.toDataURL('image/*');
	await sleep(10);

	imgBase64Str[no] = base64.replace(/^data:image\/[a-z]+;base64,/, "");
}

