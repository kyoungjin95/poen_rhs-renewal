<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="base/style/공정.css" />
    <title>토크검사서</title>
  </head>
  <body>
    <div>
      <table border="2" id="tb">
        <tr>
          <td class="base">
            <label for="management_id"><b>관리번호</b></label>
          </td>
          <td class="base">
            <input
              type="text"
              id="_management_id"
              value="조회 버튼을 누르세요"
              size="40"
              required
            />
            <button onClick="통신검사_조회();">조 회</button>
          </td>
        </tr>
        <tr>
          <td class="base">
            <label for="_재제조번호"><b>재제조번호</b></label>
          </td>
          <td class="base">
            <input
              type="text"
              id="_재제조번호"
              value="조회 버튼을 누르세요"
              size="40"
              required
            />
            <button onClick="통신검사_조회(true);">조 회</button>
          </td>
        </tr>
      </table>
    </div>
    <div id="communication">
      <button type="button" class="btn btn1">조립 토크 검사</button>
      <button type="button" class="btn btn2">조립 토크 측정값</button>
      <div id="_조립토크검사" class="check-all">
        <h3>▣ 조립 토크 검사</h3>
        <table border="2" class="all">
          <!-- <caption>
            조립 토크 검사
          </caption> -->
          <colgroup>
            <col class="col_1" />
            <col class="col_2" width="20%" />
            <col class="col_3" />
          </colgroup>
          <thead>
            <tr class="title">
              <th scope="col">항목</th>
              <th colspan="2" scope="col">케이스 조립 토크</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>장비</th>
              <td colspan="2">KTC 디지털 토크 렌치</td>
            </tr>
            <tr>
              <th>평가<br />방법</th>
              <td colspan="2">디지털 토크렌치로 볼트 풀림 토크값 확인</td>
            </tr>
            <tr>
              <th>판정<br />기준</th>
              <td colspan="2" style="color: blue">
                1.0±0.2kgf.m 의 60&#37; 이상 <br />
                (9.80±1.96Nm 의 60&#37; 이상)
              </td>
            </tr>
            <tr>
              <th rowspan="2">측정<br />결과</th>
              <td>
                측정값 <strong style="color: blue">OK</strong><br />대표사진
              </td>
              <td>
                <img id="_MeasuresOkImg" width="100%" height="100%" />
              </td>
            </tr>
            <tr>
              <td>
                측정값 <strong style="color: blue">NG</strong><br />대표사진
              </td>
              <td>
                <img id="_MeasuresNgImg" width="100%" height="100%" />
              </td>
            </tr>
            <tr>
              <th>합부판정</th>
              <td class="result" id="relay_ok" colspan="2">
                <span class="result-vlaue r1" style="color: black">OK</span>
                <strong> &sol;</strong>
                <span class="result-vlaue r2" style="color: black">NG</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <table class="bottom" width="100%">
        <tr>
          <td class="bottom" align="left">FQ850-05</td>
          <td class="bottom" align="center">A4(297x210mm)</td>
          <td class="bottom" align="right">
            Positive <font color="skyblue">En</font>ergy
          </td>
        </tr>
      </table>
      <div>
        <canvas id="_canvas"></canvas>
      </div>
      <div>
        <button onClick="통신검사_save();">SAVE</button>
        <button onClick="back();">되돌아가기</button>
      </div>
    </div>
    <script>
      var _management_id = document.getElementById("_management_id");
      var _재제조번호 = document.getElementById("_재제조번호");
      var relay_control_pic = document.getElementById('relay_control_pic');
      var relay_control = document.getElementById('relay_control');
      var relay_pack_vol = document.getElementById('relay_pack_vol');
      var cell_vol_test = document.getElementById('cell_vol_test);
      var cell_vol_max = document.getElementById('cell_vol_max');
      var cell_vol_편차 = document.getElementById('cell_vol_편차');
      var cell_vol_min = document.getElementById('cell_vol_min');
      var charicter_cell_no = document.getElementById('charicter_cell_no');
      var relay_ok = document.getElementById('relay_ok');
      var cell_vol_test_ok = document.getElementById('cell_vol_test_ok')
      var DTC = document.getElementById('DTC');
      var sensor = document.getElementById('sensor');
      var DTC2 = document.getElementById('DTC2');
      var ROM_ID = document.getElementById('ROM_ID');
    </script>
  </body>
</html>
